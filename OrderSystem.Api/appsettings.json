{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrderSystemDb": "Server=(localdb)\\mssqllocaldb;Database=OrderSystemDb;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Discounts": {
    "Regular": 1.0,
    "Employee": 0.5,
    "VIP": 0.8,
    "WholeSale": 0.85
  },
  "Jwt": {
    "Secret": "REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS",
    "Issuer": "OrderSystem",
    "Audience": "OrderSystemClients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  }
}
