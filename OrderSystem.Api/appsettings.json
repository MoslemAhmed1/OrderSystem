{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "OrderSystemDb": "Server=(localdb)\\mssqllocaldb;Database=OrderSystemDb;Trusted_Connection=True;TrustServerCertificate=True",
    "Redis": "localhost:6379"
  },
  "Localization": {
    "DefaultCulture": "en",
    "SupportedCultures": [ "en", "ar", "de" ]
  },
  "Caching": {
    "Provider": "Redis",
    "DefaultExpirationMinutes": 10,
    "SlidingExpirationMinutes": 5,
    "VersionExpirationDays": 30
  },
  "Discounts": {
    "Regular": 1.0,
    "Employee": 0.5,
    "VIP": 0.8,
    "WholeSale": 0.85
  },
  "Jwt": {
    "Secret": "MySecretKeyIs32CharactersLong12!",
    "Issuer": "OrderSystem",
    "Audience": "OrderSystemClients",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "TokenCleanupIntervalHours": 24
  }
}